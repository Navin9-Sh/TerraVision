# Copy this file to .env (gitignored, never committed) and fill in real values
# before running `docker compose up`. See DEPLOYMENT.md for what each one does
# and where to get it (e.g. Brevo's SMTP & API tab).

TERRAVISION_JWT_SECRET=generate-with-openssl-rand-base64-32
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-unique-password
MAIL_FROM_ADDRESS=you@example.com
APP_BASE_URL=http://localhost:8080
BREVO_SMTP_USERNAME=your-brevo-smtp-login
BREVO_SMTP_PASSWORD=your-brevo-smtp-key
